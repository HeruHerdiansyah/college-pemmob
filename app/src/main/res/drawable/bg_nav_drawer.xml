<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base gradient matching bg_gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1A1A2E"
                android:centerColor="#16213E"
                android:endColor="#0F3460"
                android:type="linear" />
        </shape>
    </item>

    <!-- Small decorative circle — bottom left -->
    <item
        android:gravity="bottom|start"
        android:width="90dp"
        android:height="90dp"
        android:left="-25dp"
        android:bottom="-25dp">
        <shape android:shape="oval">
            <solid android:color="#15E94560" />
        </shape>
    </item>

    <!-- Tiny decorative circle — bottom left (inner) -->
    <item
        android:gravity="bottom|start"
        android:width="50dp"
        android:height="50dp"
        android:left="-10dp"
        android:bottom="-10dp">
        <shape android:shape="oval">
            <solid android:color="#100F3460" />
        </shape>
    </item>

</layer-list>
