<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Assignment" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Status bar and navigation bar colors -->
        <item name="android:statusBarColor">@color/bg_dark_primary</item>
        <item name="android:navigationBarColor">@color/bg_dark_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorPrimaryVariant">@color/accent_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Theme.Assignment" parent="Base.Theme.Assignment" />

    <style name="NavMenuTextStyle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>